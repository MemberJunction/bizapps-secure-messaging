{
  "name": "mj-secure-messaging",
  "version": "1.0.0",
  "license": "MIT",
  "description": "MJ Secure Messaging - a secure web messaging portal Open App for MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n\\u274c Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\"",
    "build": "pnpm run build:stream",
    "build:stream": "turbo --log-order=stream build --filter=\"@mj-biz-apps/*\"",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/secure-messaging-entities\" --filter=\"@mj-biz-apps/secure-messaging-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/secure-messaging-*\"",
    "mj": "mj",
    "mj:migrate": "mj migrate",
    "mj:codegen": "mj codegen",
    "change": "changeset",
    "version": "changeset version",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs",
    "test:integration": "node test-harnesses/integration.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-secure-messaging"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@angular-devkit/build-angular": "21.2.23",
      "@angular/animations": "21.2.22",
      "@angular/build": "21.2.23",
      "@angular/cdk": "21.2.14",
      "@angular/cli": "21.2.23",
      "@angular/common": "21.2.22",
      "@angular/compiler": "21.2.22",
      "@angular/compiler-cli": "21.2.22",
      "@angular/core": "21.2.22",
      "@angular/elements": "21.2.22",
      "@angular/forms": "21.2.22",
      "@angular/localize": "21.2.22",
      "@angular/platform-browser": "21.2.22",
      "@angular/platform-browser-dynamic": "21.2.22",
      "@angular/router": "21.2.22",
      "@angular/service-worker": "21.2.22",
      "@types/express": "^5.0.6"
    }
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/service-worker": "21.2.22",
    "@angular/router": "21.2.22",
    "@okta/okta-auth-js": "^7.14.1",
    "@workos-inc/authkit-js": "^0.20.1",
    "aws-amplify": "^6.0.0",
    "@memberjunction/actions": "^6.1.2",
    "@memberjunction/actions-base": "^6.1.2",
    "@memberjunction/communication-types": "^6.1.2",
    "@memberjunction/communication-engine": "^6.1.2",
    "@memberjunction/core": "^6.1.2",
    "@memberjunction/core-entities": "^6.1.2",
    "@memberjunction/esignature": "^6.1.2",
    "@memberjunction/esignature-docusign": "^6.1.2",
    "@memberjunction/esignature-dropboxsign": "^6.1.2",
    "@memberjunction/esignature-pandadoc": "^6.1.2",
    "@memberjunction/global": "^6.1.2",
    "@memberjunction/graphql-dataprovider": "^6.1.2",
    "@memberjunction/ng-base-application": "^6.1.2",
    "@memberjunction/ng-shared": "^6.1.2",
    "@memberjunction/server": "^6.1.2",
    "@memberjunction/sqlserver-dataprovider": "^6.1.2",
    "@memberjunction/storage": "^6.1.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "^6.1.2",
    "@memberjunction/testing-integration": "^6.1.2",
    "@mj-biz-apps/common-entities": "^5.30.0",
    "@mj-biz-apps/secure-messaging-entities": "workspace:*",
    "@mj-biz-apps/secure-messaging-integration-tests": "workspace:*",
    "@mj-biz-apps/secure-messaging-server": "workspace:*",
    "dotenv": "^17.2.4",
    "mssql": "^11.0.1",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
