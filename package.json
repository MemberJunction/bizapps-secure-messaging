{
  "name": "mj-secure-messaging",
  "version": "1.1.0",
  "license": "MIT",
  "description": "MJ Secure Messaging - a secure web messaging portal Open App for MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n\\u274c Dependencies not installed. Run: npm install\\n'); process.exit(1); }\"",
    "build": "npm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/secure-messaging-*\"",
    "mj": "npx @memberjunction/cli",
    "mj:migrate": "npx @memberjunction/cli migrate",
    "mj:codegen": "npx @memberjunction/cli codegen"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MJ-Central/app-secure-messaging"
  },
  "packageManager": "npm@10.5.0",
  "dependencies": {
    "@memberjunction/actions": "5.40.2",
    "@memberjunction/actions-base": "5.40.2",
    "@memberjunction/communication-types": "5.40.2",
    "@memberjunction/core": "5.40.2",
    "@memberjunction/core-entities": "5.40.2",
    "@memberjunction/esignature": "5.40.2",
    "@memberjunction/esignature-docusign": "5.40.2",
    "@memberjunction/esignature-dropboxsign": "5.40.2",
    "@memberjunction/esignature-pandadoc": "5.40.2",
    "@memberjunction/global": "5.40.2",
    "@memberjunction/graphql-dataprovider": "5.40.2",
    "@memberjunction/ng-base-application": "5.40.2",
    "@memberjunction/ng-shared": "5.40.2",
    "@memberjunction/server": "5.40.2",
    "@memberjunction/storage": "5.40.2"
  },
  "overrides": {
    "@angular/animations": "21.1.3",
    "@angular/build": "21.1.3",
    "@angular/cli": "21.1.3",
    "@angular/common": "21.1.3",
    "@angular/compiler": "21.1.3",
    "@angular/compiler-cli": "21.1.3",
    "@angular/core": "21.1.3",
    "@angular/forms": "21.1.3",
    "@angular/localize": "21.1.3",
    "@angular/platform-browser": "21.1.3",
    "@angular/platform-browser-dynamic": "21.1.3",
    "@angular/router": "21.1.3",
    "@angular-devkit/build-angular": "21.1.3"
  },
  "devDependencies": {
    "tsc-alias": "^1.8.16",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  }
}
