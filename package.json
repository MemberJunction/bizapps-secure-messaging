{
  "name": "mj-secure-messaging",
  "version": "1.0.0",
  "license": "MIT",
  "description": "MJ Secure Messaging - a secure web messaging portal Open App for MemberJunction",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n\\u274c Dependencies not installed. Run: npm install\\n'); process.exit(1); }\"",
    "build": "npm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/secure-messaging-entities\" --filter=\"@mj-biz-apps/secure-messaging-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/secure-messaging-*\"",
    "build:api": "turbo --log-order=stream build --filter=\"mj_api\"",
    "build:explorer": "turbo --log-order=stream build --filter=\"mj_explorer\"",
    "start": "turbo start --filter=mj_explorer --filter=mj_api",
    "start:api": "turbo start --filter=mj_api",
    "start:explorer": "turbo start --filter=mj_explorer",
    "mj": "npx @memberjunction/cli",
    "mj:migrate": "npx @memberjunction/cli migrate",
    "mj:codegen": "npx @memberjunction/cli codegen",
    "change": "changeset",
    "version": "changeset version",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs",
    "test:integration": "node test-harnesses/integration.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-secure-messaging"
  },
  "packageManager": "npm@10.5.0",
  "dependencies": {
    "@angular/service-worker": "21.1.3",
    "@okta/okta-auth-js": "^7.14.1",
    "@workos-inc/authkit-js": "^0.20.1",
    "aws-amplify": "^6.0.0",
    "@memberjunction/actions": "^6.1.0-edge.4",
    "@memberjunction/actions-base": "^6.1.0-edge.4",
    "@memberjunction/communication-types": "^6.1.0-edge.4",
    "@memberjunction/communication-engine": "^6.1.0-edge.4",
    "@memberjunction/core": "^6.1.0-edge.4",
    "@memberjunction/core-entities": "^6.1.0-edge.4",
    "@memberjunction/esignature": "^6.1.0-edge.4",
    "@memberjunction/esignature-docusign": "^6.1.0-edge.4",
    "@memberjunction/esignature-dropboxsign": "^6.1.0-edge.4",
    "@memberjunction/esignature-pandadoc": "^6.1.0-edge.4",
    "@memberjunction/global": "^6.1.0-edge.4",
    "@memberjunction/graphql-dataprovider": "^6.1.0-edge.4",
    "@memberjunction/ng-base-application": "^6.1.0-edge.4",
    "@memberjunction/ng-shared": "^6.1.0-edge.4",
    "@memberjunction/server": "^6.1.0-edge.4",
    "@memberjunction/sqlserver-dataprovider": "^6.1.0-edge.4",
    "@memberjunction/storage": "^6.1.0-edge.4"
  },
  "overrides": {
    "@angular/animations": "21.1.3",
    "@angular/build": "21.1.3",
    "@angular/cli": "21.1.3",
    "@angular/common": "21.1.3",
    "@angular/compiler": "21.1.3",
    "@angular/compiler-cli": "21.1.3",
    "@angular/core": "21.1.3",
    "@angular/forms": "21.1.3",
    "@angular/localize": "21.1.3",
    "@angular/platform-browser": "21.1.3",
    "@angular/platform-browser-dynamic": "21.1.3",
    "@angular/router": "21.1.3",
    "@angular-devkit/build-angular": "21.1.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@memberjunction/testing-integration": "^6.1.0-edge.4",
    "@mj-biz-apps/secure-messaging-integration-tests": "1.1.0",
    "dotenv": "^17.2.4",
    "mssql": "^11.0.1",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  }
}
