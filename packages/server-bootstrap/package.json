{
  "name": "@mj-biz-apps/secure-messaging-bootstrap",
  "version": "1.1.0",
  "description": "Server bootstrap package for MJ Secure Messaging. Registers the Secure Web communication provider and exports the startup function.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mj-class-registrations": {
      "types": "./dist/mj-class-registrations.d.ts",
      "default": "./dist/mj-class-registrations.js"
    }
  },
  "scripts": {
    "prebuild": "mj codegen manifest --exclude-packages @memberjunction --output ./src/generated/mj-class-registrations.ts || echo 'Warning: mj codegen manifest not available, using existing manifest'",
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@mj-biz-apps/secure-messaging-server": "^1.1.0"
  },
  "peerDependencies": {
    "@memberjunction/core": "^5.40.2",
    "@memberjunction/esignature-docusign": "^5.40.2",
    "@memberjunction/esignature-pandadoc": "^5.40.2",
    "@memberjunction/esignature-dropboxsign": "^5.40.2"
  },
  "devDependencies": {
    "@memberjunction/core": "^5.40.2",
    "@memberjunction/esignature-docusign": "^5.40.2",
    "@memberjunction/esignature-pandadoc": "^5.40.2",
    "@memberjunction/esignature-dropboxsign": "^5.40.2",
    "typescript": "^5.4.5"
  }
}
