{
  "name": "@mj-biz-apps/secure-messaging-element",
  "version": "2.1.0",
  "description": "MJ Secure Messaging external contact widget — bundles the conversation UI into a single <mj-secure-messaging> custom element embeddable on any website (REST + token auth).",
