{
  "name": "@mj-biz-apps/secure-messaging-integration-tests",
  "type": "module",
  "version": "6.3.0-edge.1",
  "private": true,
  "description": "Integration check bundles, multi-entity world fixtures, adversarial cross-tenant RLS checks, and headless Playwright visual checks for MJ Secure Messaging.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias -f",
    "test": "DB_HOST=localhost DB_DATABASE=test DB_USERNAME=test DB_PASSWORD=test vitest run src/__tests__/artifact-file-store-rls.integration.spec.ts",
    "test:playwright": "vitest run src/__tests__/artifact-preview.playwright.spec.ts",
    "test:all": "DB_HOST=localhost DB_DATABASE=test DB_USERNAME=test DB_PASSWORD=test vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@mj-biz-apps/common-entities": "^5.30.0",
