{
  "$schema": "https://schema.memberjunction.org/mj-app/v1.json",
  "manifestVersion": 1,
  "name": "mj-secure-messaging",
  "displayName": "MJ Secure Messaging",
  "description": "A secure client portal for exchanging messages, documents, and e-signatures with external contacts. Passwordless magic-link entry deep-links contacts into subject-lined conversation threads; staff work the same threads from an inbox in MJ Explorer. Includes file requests with a full lifecycle, e-signature via the MJ eSignature engine, and an embeddable <mj-secure-messaging> Angular Element widget any site can host.",
  "version": "2.1.0",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/bizapps-secure-messaging",
  "mjVersionRange": ">=6.1.2 <7.0.0",
  "license": "MIT",
  "dependencies": {
    "mj-bizapps-common": {
      "version": ">=5.30.0 <6.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-common"
    }
  },
  "icon": "fa-solid fa-shield-halved",
  "color": "#1a73e8",
  "schema": {
    "name": "__mj_BizAppsSecureMessaging",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@mj-biz-apps/secure-messaging-server",
        "role": "bootstrap",
        "startupExport": "LoadSecureMessagingServer"
      }
    ],
    "client": [
      {
        "name": "@mj-biz-apps/secure-messaging-ng",
        "role": "bootstrap",
        "startupExport": "LoadSecureMessagingClient"
      }
    ],
    "shared": [
      {
        "name": "@mj-biz-apps/secure-messaging-entities",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/secure-messaging-core",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/secure-messaging-actions",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/secure-messaging-element",
        "role": "components"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": [
    "communication",
    "security"
  ],
  "tags": [
    "secure-messaging",
    "portal",
    "web-channel",
    "angular-element"
  ]
}
