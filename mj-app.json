{
  "manifestVersion": 1,
  "name": "mj-secure-messaging",
  "displayName": "MJ Secure Messaging",
  "description": "A secure web messaging portal that allows external contacts to communicate with organizations through an embeddable Angular Element widget. Integrates with MJ's channel system for AI-powered responses and approval workflows.",
  "version": "1.1.0",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MJ-Central/app-secure-messaging",
  "mjVersionRange": ">=5.0.0",
  "license": "MIT",
  "icon": "fa-solid fa-shield-halved",
  "color": "#1a73e8",
  "schema": {
    "name": "secure_messaging",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "registry": "https://registry.npmjs.org",
    "prefix": "@memberjunction/",
    "server": [
      {
        "name": "@memberjunction/secure-messaging-bootstrap",
        "role": "bootstrap",
        "startupExport": "LoadSecureMessaging"
      }
    ],
    "client": [
      {
        "name": "@memberjunction/ng-secure-messaging-bootstrap",
        "role": "bootstrap",
        "startupExport": "LoadSecureMessagingClient"
      }
    ],
    "shared": [
      {
        "name": "@memberjunction/secure-messaging-server",
        "role": "library"
      },
      {
        "name": "@memberjunction/ng-secure-messaging",
        "role": "library"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": ["communication", "security"],
  "tags": ["secure-messaging", "portal", "web-channel", "angular-element"]
}
