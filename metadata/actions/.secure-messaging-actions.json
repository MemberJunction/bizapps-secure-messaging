  {
    "fields": {
      "Name": "Promote Thread",
      "Description": "Promotes an existing insecure (Email/SMS) thread into a secure thread: find-or-create the contact Person, mint thread + portal session + single-use magic link, then COPY the prior insecure messages into the secure thread (flagged IsImported, tagged with SourceChannel) so the contact sees the full history once authenticated. One-way visibility: imported messages live only on the secure side. Shared backbone of both channel bridges (Izzy action-diff 'switch to secure channel' and the Outlook 'Secure Send' add-in). Returns the magic-link token for out-of-band delivery (?ml=<token>).",
      "Type": "Custom",
      "DriverClass": "__PromoteThread",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Secure Messaging",
      "Status": "Active",
      "CodeApprovalStatus": "Approved"
    },
