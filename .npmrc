# Save exact versions (matching the MJ pattern — every @memberjunction/* and
# @mj-biz-apps/* spec in this repo is an exact pin, not a range).
# Read by both npm and pnpm, so no "Unknown project config" warnings from the
# `npm view` calls in .github/scripts/validate-npm-packages.sh.
save-exact=true

# Strict SSL
strict-ssl=true
